#include <bits/stdc++.h>
using namespace std;
 
void solve() {
    int n;
    cin >> n;
    int k;
    cin >> k;
    vector<int> arr(n);
    bool found=false;
    
    for ( int i=0 ; i<n ; i++) {
        cin >> arr[i] ; 
        if (arr[i] == k) {
           found = true;
        }
       
    }
    if (found) {
        cout << "YES
" ;
    
    }
    else {
        cout << "NO
" ;
    }
    
}
 
int main() {
    int t;
    cin >> t;
    while(t--) {
        solve();
    }
    return 0;
}